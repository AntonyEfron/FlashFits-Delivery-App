{
  "expo": {
    "name": "FlashFits-delivery-app",
    "slug": "FlashFits-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "flashfits",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flashfits.delivery",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "This app needs your location to assign nearby orders and navigate to pickup/delivery.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs your location in the background to track order delivery status and calculate incentives.",
        "NSLocationAlwaysUsageDescription": "This app needs your location in the background to track order delivery status and calculate incentives."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.flashfits.delivery",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      // "BACKEND_URL": "http://192.168.29.230:5000",
      "BACKEND_URL": "https://api.theflashfits.com",
      "eas": {
        "projectId": "e1c32e96-5683-4f7d-acb3-58a1b3fa69b1"
      }
    }
  }
}